# Application Port
PORT=3000

# ──────────────────────────────────────────────────
# Database URL for Prisma (PostgreSQL)
# ──────────────────────────────────────────────────
# Local development:
# DATABASE_URL="postgresql://username:password@localhost:5432/estoque_karoquissimo"
#
# Supabase (staging / pre-produção):
# Pegue em: Supabase → Connect → ORM
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[SUA-SENHA]@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[SUA-SENHA]@aws-1-us-west-2.pooler.supabase.com:5432/postgres"
#
# Hostinger VPS (produção):
# DATABASE_URL="postgresql://postgres:senha@localhost:5432/estoque_karoquissimo"
DATABASE_URL="postgresql://username:password@localhost:5432/estoque_karoquissimo"

# CORS Frontend URL
# Desenvolvimento: http://localhost:5173
# Produção: https://seu-dominio.com
FRONTEND_URL="http://localhost:5173"

# JWT Secret Key (use uma chave forte e aleatória em produção)
JWT_SECRET="change-this-to-a-very-strong-random-key-in-production"

# JWT Token expiration (ex: 8h, 1d, 7d)
JWT_EXPIRES_IN=8h
