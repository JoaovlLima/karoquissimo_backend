generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             Int             @id @default(autoincrement()) @map("id")
  name           String          @map("nome") @db.VarChar(100)
  email          String          @unique @map("email") @db.VarChar(150)
  passwordHash   String          @map("senha_hash") @db.VarChar(255)
  isActive       Boolean         @default(true) @map("ativo")
  createdAt      DateTime        @default(now()) @map("criado_em")
  companyId      Int             @default(1) @map("empresa_id")
  stockMovements StockMovement[]
  company        Company         @relation(fields: [companyId], references: [id])
  sales          Sale[]

  @@map("usuarios")
}

model Company {
  id            Int        @id @default(autoincrement()) @map("id")
  corporateName String     @map("razao_social") @db.VarChar(150)
  tradeName     String     @map("nome_fantasia") @db.VarChar(150)
  cnpj          String     @unique @map("cnpj") @db.VarChar(18)
  phone         String     @map("telefone") @db.VarChar(20)
  whatsapp      String?    @map("whatsapp") @db.VarChar(20)
  email         String?    @map("email") @db.VarChar(150)
  street        String     @map("logradouro") @db.VarChar(200)
  number        String     @map("numero") @db.VarChar(10)
  complement    String?    @map("complemento") @db.VarChar(100)
  neighborhood  String     @map("bairro") @db.VarChar(100)
  city          String     @map("cidade") @db.VarChar(100)
  state         String     @map("uf") @db.Char(2)
  zipCode       String     @map("cep") @db.VarChar(10)
  categories    Category[]
  clients       Client[]
  products      Product[]
  users         User[]
  sales         Sale[]

  @@map("empresa")
}

model Client {
  id           Int      @id @default(autoincrement()) @map("id")
  fullName     String   @map("nome_completo") @db.VarChar(150)
  cpf          String   @unique @map("cpf") @db.VarChar(14)
  birthDate    DateTime @map("data_nascimento") @db.Date
  phone        String   @map("telefone") @db.VarChar(20)
  whatsapp     String?  @map("whatsapp") @db.VarChar(20)
  email        String?  @map("email") @db.VarChar(150)
  street       String   @map("logradouro") @db.VarChar(200)
  number       String   @map("numero") @db.VarChar(10)
  complement   String?  @map("complemento") @db.VarChar(100)
  neighborhood String   @map("bairro") @db.VarChar(100)
  city         String   @map("cidade") @db.VarChar(100)
  state        String   @map("uf") @db.Char(2)
  zipCode      String   @map("cep") @db.VarChar(10)
  isActive     Boolean  @default(true) @map("ativo")
  createdAt    DateTime @default(now()) @map("criado_em")
  companyId    Int      @default(1) @map("empresa_id")
  company      Company  @relation(fields: [companyId], references: [id])
  sales        Sale[]

  @@map("clientes")
}

model Category {
  id        Int       @id @default(autoincrement()) @map("id")
  name      String    @map("nome") @db.VarChar(80)
  companyId Int       @default(1) @map("empresa_id")
  company   Company   @relation(fields: [companyId], references: [id])
  products  Product[]

  @@unique([companyId, name])
  @@map("categorias")
}

model Product {
  id             Int             @id @default(autoincrement()) @map("id")
  code           String          @map("codigo") @db.VarChar(50)
  name           String          @map("nome") @db.VarChar(150)
  categoryId     Int             @map("categoria_id")
  color          String          @map("cor") @db.VarChar(50)
  size           String          @map("tamanho") @db.VarChar(20)
  price          Decimal         @map("valor") @db.Decimal(10, 2)
  units          Int             @default(0) @map("unidades")
  supplier       String          @map("fornecedor") @db.VarChar(150)
  expirationDate DateTime?       @map("validade") @db.Date
  createdAt      DateTime        @default(now()) @map("criado_em")
  updatedAt      DateTime        @default(now()) @updatedAt @map("atualizado_em")
  companyId      Int             @default(1) @map("empresa_id")
  photoUrl      String?          @map("photo_url") @db.VarChar(500)
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  category       Category        @relation(fields: [categoryId], references: [id])
  company        Company         @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("produtos")
}

model StockMovement {
  id        Int               @id @default(autoincrement()) @map("id")
  productId Int               @map("produto_id")
  type      StockMovementType @map("tipo")
  quantity  Int               @map("quantidade")
  reason    String            @map("motivo") @db.VarChar(200)
  userId    Int               @map("usuario_id")
  createdAt DateTime          @default(now()) @map("criado_em")
  product   Product           @relation(fields: [productId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@map("movimentacoes_estoque")
}

model Sale {
  id             Int           @id @default(autoincrement()) @map("id")
  documentNumber String        @unique @map("numero_doc") @db.VarChar(20)
  clientId       Int           @map("cliente_id")
  userId         Int           @map("usuario_id")
  totalValue     Decimal       @map("valor_total") @db.Decimal(10, 2)
  entryValue     Decimal       @default(0) @map("valor_entrada") @db.Decimal(10, 2)
  remainingValue Decimal       @map("valor_restante") @db.Decimal(10, 2)
  status         SaleStatus    @default(PENDING) @map("status")
  observation    String?       @map("observacao")
  createdAt      DateTime      @default(now()) @map("criado_em")
  companyId      Int           @default(1) @map("empresa_id")
  saleItems      SaleItem[]
  installments   Installment[]
  client         Client        @relation(fields: [clientId], references: [id])
  company        Company       @relation(fields: [companyId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@map("vendas")
}

model SaleItem {
  id         Int     @id @default(autoincrement()) @map("id")
  saleId     Int     @map("venda_id")
  productId  Int     @map("produto_id")
  quantity   Int     @map("quantidade")
  unitPrice  Decimal @map("valor_unitario") @db.Decimal(10, 2)
  totalPrice Decimal @map("valor_total") @db.Decimal(10, 2)
  product    Product @relation(fields: [productId], references: [id])
  sale       Sale    @relation(fields: [saleId], references: [id])

  @@map("itens_venda")
}

model Installment {
  id      Int               @id @default(autoincrement()) @map("id")
  saleId  Int               @map("venda_id")
  number  Int               @map("numero")
  value   Decimal           @map("valor") @db.Decimal(10, 2)
  dueDate DateTime          @map("vencimento") @db.Date
  paidAt  DateTime?         @map("pago_em") @db.Date
  status  InstallmentStatus @default(PENDING) @map("status")
  sale    Sale              @relation(fields: [saleId], references: [id])

  @@map("parcelas")
}

enum StockMovementType {
  IN         @map("entrada")
  OUT        @map("saida")
  ADJUSTMENT @map("ajuste")

  @@map("tipo_movimentacao")
}

enum SaleStatus {
  PAID      @map("quitada")
  PENDING   @map("pendente")
  CANCELLED @map("cancelada")

  @@map("status_venda")
}

enum InstallmentStatus {
  PENDING @map("pendente")
  PAID    @map("pago")
  OVERDUE @map("atrasado")

  @@map("status_parcela")
}
